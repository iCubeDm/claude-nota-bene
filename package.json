{
  "name": "nota-bene",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "nota-bene": "bin/nota-bene.mjs"
  },
  "engines": {
    "node": ">=23.6"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
