{
  "name": "nota-bene",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "dev": "concurrently --kill-others-on-fail \"node --watch server/src/main.ts --port 4780 --allow-origin http://localhost:5173\" \"vite web\"",
    "start": "npm run build -w web && node server/src/main.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "concurrently": "10.0.6",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
