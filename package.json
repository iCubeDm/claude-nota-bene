    "dev:open": "node scripts/dev-open.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
