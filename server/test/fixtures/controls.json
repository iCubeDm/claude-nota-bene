    { "value": "opus", "name": "Opus 5", "description": "Hardest problems", "resolved": "claude-opus-5", "efforts": ["medium", "high", "max"] },
    { "value": "haiku", "name": "Haiku 5", "description": "Fast and light", "resolved": "claude-haiku-5" }
  ],
  "sessions": [
    {
      "id": "11111111-1111-4111-8111-111111111111", "cwd": ".", "customTitle": "Alpha session", "lastModified": 1700000000000, "fileSize": 2048,
