      "history": [{ "role": "user", "text": "beta question" }, { "role": "assistant", "text": "beta answer" }]
    }
  ],
  "subagents": [
    {
      "toolUseId": "toolu_e2e_resumed", "type": "general-purpose", "description": "Resumed reviewer",
      "messages": [
        { "role": "user", "text": "Review again" },
        { "role": "assistant", "text": "The resumed agent answers from its own transcript." }
      ]
    },
    {
      "toolUseId": "toolu_e2e_done", "type": "general-purpose", "description": "Review batch fixes",
      "messages": [
        { "role": "user", "text": "Review the diff" },
        { "role": "assistant", "text": "Reading the changed files first.", "tools": [{ "id": "toolu_e2e_inner", "name": "Bash", "input": { "command": "git diff --stat" }, "output": "3 files changed" }] },
        { "role": "assistant", "text": "The send path looks correct and the tests cover it." }
      ]
    },
    {
      "toolUseId": "toolu_e2e_run", "type": "Explore", "description": "Look around the repo", "running": true,
      "messages": [
        { "role": "user", "text": "Explore" },
        { "role": "assistant", "text": "Still exploring the repository layout." }
      ]
    }
  ],
  "turns": [
    { "text": "plain reply", "compactMs": 1500, "suggestions": ["notes.md"] },
    { "match": "[agents]", "text": "subagents launched", "tools": [
      { "id": "toolu_e2e_done", "name": "Agent", "input": { "subagent_type": "general-purpose", "description": "Review batch fixes", "prompt": "Review the diff" }, "output": "agentId: e2edone01 (finished)" },
      { "id": "toolu_e2e_run", "name": "Agent", "input": { "subagent_type": "Explore", "description": "Look around the repo", "prompt": "Explore" }, "output": "Async agent launched successfully. agentId: e2erun02" }
    ] },
    {
      "match": "[resume]", "text": "agent resumed",
      "frames": [
        { "type": "system", "subtype": "task_started", "task_id": "e2e-resumed", "description": "Resumed reviewer", "task_type": "local_agent", "tool_use_id": "toolu_e2e_resumed" },
        { "type": "system", "subtype": "task_notification", "task_id": "e2e-resumed", "status": "completed" },
        { "type": "system", "subtype": "task_started", "task_id": "e2e-resumed", "description": "Resumed reviewer", "task_type": "local_agent", "tool_use_id": "toolu_e2e_sendmsg" }
      ],
      "tools": [
        { "id": "toolu_e2e_resumed", "name": "Agent", "input": { "subagent_type": "general-purpose", "description": "Resumed reviewer", "prompt": "Review again" }, "output": "Async agent launched successfully. agentId: e2eres03" }
      ]
    },
    { "match": "[plan]", "text": "Here is the plan.", "ask": { "toolName": "ExitPlanMode", "input": { "plan": "## The plan\n\nStep one: rename bravo.\n\nStep two: run the tests.\n" }, "onAllow": "default" } },
    { "match": "[initmode]", "text": "the CLI changed the mode", "initMode": "acceptEdits" },
    { "match": "[warn]", "text": "context is filling", "context": { "used": 130000, "max": 200000, "pct": 65 } },
    { "match": "[hot]", "text": "context is nearly full", "context": { "used": 180000, "max": 200000, "pct": 90 } },
    { "match": "[suggest]", "text": "suggestion follows", "suggestion": "now write the tests" },
    { "match": "[boom]", "text": "crashing now", "crash": true },
    { "match": "[slow]", "text": "A slow reply that keeps the agent busy for a few seconds, chunk by chunk.", "chunk": 4, "delayMs": 150 },
    {
      "match": "[tasks]", "text": "tasks finished",
      "frames": [
        { "type": "system", "subtype": "task_started", "task_id": "t-e2e", "description": "Explore the repo", "task_type": "local_agent" },
        { "type": "system", "subtype": "task_progress", "task_id": "t-e2e", "usage": { "total_tokens": 4500 }, "last_tool_name": "Grep", "summary": "searching" },
        { "sleepMs": 2500 },
        { "type": "system", "subtype": "task_notification", "task_id": "t-e2e", "status": "completed" }
      ]
    },
    {
      "match": "[tasks-drawer]", "text": "tasks started",
      "frames": [
        { "type": "system", "subtype": "task_started", "task_id": "e2e-sh-run", "description": "tail -f build.log", "task_type": "local_bash" },
        { "type": "system", "subtype": "task_started", "task_id": "e2e-sh-done", "description": "npm run lint", "task_type": "local_bash" },
        { "type": "system", "subtype": "task_notification", "task_id": "e2e-sh-done", "status": "completed" },
        { "type": "system", "subtype": "task_started", "task_id": "e2e-ag-bg", "description": "Index the docs", "task_type": "local_agent", "tool_use_id": "toolu_e2e_bg", "is_backgrounded": true },
        { "type": "system", "subtype": "task_progress", "task_id": "e2e-ag-bg", "usage": { "total_tokens": 12300 }, "last_tool_name": "Read", "summary": "reading docs/architecture.md" },
        { "type": "system", "subtype": "task_started", "task_id": "e2e-sh-child", "description": "grep -rn TODO docs", "task_type": "local_bash", "parent_task_id": "e2e-ag-bg" }
      ]
    }
  ],
  "shells": [
    { "taskId": "e2e-sh-run", "chunks": ["> build started\n", "compiling 1/4\n", "\u001b[32mcompiling 2/4\u001b[0m\n", "compiling 3/4\n", "compiling 4/4\n", "build finished\n"] },
    { "taskId": "e2e-sh-done", "chunks": ["lint: 0 problems\n"] },
    { "taskId": "e2e-sh-child", "chunks": ["docs/a.md:3: TODO\n"] }
  ]
}
